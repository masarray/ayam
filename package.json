{
  "name": "voxel-crossing-game",
  "version": "2.7.0",
  "type": "module",
  "description": "A lightweight Three.js voxel crossing browser game with smart traffic, trains, rivers, lazy-loaded music, celebratory rewards, and a fullscreen learning quiz that appears after every third game over.",
  "license": "Apache-2.0",
  "author": "Ari Sulistiono",
  "homepage": "https://masarray.github.io/voxel-crossing-game/",
  "repository": {
    "type": "git",
    "url": "https://github.com/masarray/voxel-crossing-game.git"
  },
  "bugs": {
    "url": "https://github.com/masarray/voxel-crossing-game/issues"
  },
  "keywords": [
    "threejs",
    "react",
    "vite",
    "web-game",
    "voxel-game",
    "browser-game",
    "github-pages",
    "educational-game",
    "mobile-game"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "verify": "node scripts/verify-repo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "vite": "^8.0.16"
  }
}
