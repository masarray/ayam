{
  "name": "ayam-sd",
  "version": "3.4.9",
  "type": "module",
  "description": "Free and open-source Three.js Ayam SD browser game with a voxel chicken, traffic, trains, rivers, rewards, audio, mobile controls, and a learning quiz loop.",
  "license": "Apache-2.0",
  "author": "Ari Sulistiono",
  "homepage": "https://masarray.github.io/ayam/",
  "repository": {
    "type": "git",
    "url": "https://github.com/masarray/ayam.git"
  },
  "bugs": {
    "url": "https://github.com/masarray/ayam/issues"
  },
  "keywords": [
    "ayam-sd",
    "threejs",
    "react",
    "vite",
    "web-game",
    "voxel-game",
    "browser-game",
    "github-pages",
    "educational-game",
    "kids-game",
    "mobile-game",
    "pwa"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "verify": "node scripts/verify-repo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
